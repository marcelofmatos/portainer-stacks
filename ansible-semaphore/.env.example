# Variáveis para subir a stack "ansible-semaphore". Copie para .env: cp .env.example .env
# (No Portainer App Template, esses valores são pedidos no formulário.)

# ─────────── Obrigatórias ───────────
# Domínio (FQDN) — Ex.: semaphore.exemplo.com [OBRIGATÓRIA]
SEMAPHORE_FQDN=

# Senha do banco — usada pelo app e pelo PostgreSQL embarcado [OBRIGATÓRIA]
SEMAPHORE_DB_PASSWORD=

# Senha do admin — criado na 1ª subida [OBRIGATÓRIA]
SEMAPHORE_ADMIN_PASSWORD=

# E-mail do admin [OBRIGATÓRIA]
SEMAPHORE_ADMIN_EMAIL=

# Chave de cifra das chaves/segredos salvos — gere com: head -c32 /dev/urandom | base64 — NÃO troque depois [OBRIGATÓRIA]
SEMAPHORE_ACCESS_KEY_ENCRYPTION=

# ─────────── Opcionais (defaults abaixo) ───────────
# Login do admin
SEMAPHORE_ADMIN=admin

# Nome exibido do admin
SEMAPHORE_ADMIN_NAME=Admin

# Usuário do banco
SEMAPHORE_DB_USER=semaphore

# Nome do banco
SEMAPHORE_DB_NAME=semaphore

# Fuso horário (agendamentos e logs)
TZ=America/Sao_Paulo

# Tag da imagem semaphoreui/semaphore
SEMAPHORE_IMAGE_TAG=v2.19.17

# Rede do proxy
PROXY_NET=web

# Rede de dados (pgadmin4)
DATA_NET=data
