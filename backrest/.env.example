# Variáveis para subir a stack "backrest". Copie para .env: cp .env.example .env
# (No Portainer App Template, esses valores são pedidos no formulário.)

# ─────────── Obrigatórias ───────────
# Domínio (FQDN) — Ex.: backup.exemplo.com [OBRIGATÓRIA]
BACKREST_FQDN=

# ─────────── Opcionais (defaults abaixo) ───────────
# Fuso horário (horário dos agendamentos)
TZ=America/Sao_Paulo

# Nome gravado como host nos snapshots do restic
BACKREST_HOSTNAME=backrest

# Tag da imagem garethgeorge/backrest
BACKREST_IMAGE_TAG=latest

# Rede do proxy
PROXY_NET=web
