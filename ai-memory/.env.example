# Variáveis para subir a stack "ai-memory". Copie para .env: cp .env.example .env
# (No Portainer App Template, esses valores são pedidos no formulário.)

# ─────────── Obrigatórias ───────────
# Domínio (FQDN) — Ex.: memory.exemplo.com [OBRIGATÓRIA]
AI_MEMORY_FQDN=

# Bearer token (longo e aleatório, ex.: openssl rand -hex 32); também é a senha da UI /web [OBRIGATÓRIA]
AI_MEMORY_AUTH_TOKEN=

# ─────────── Opcionais (defaults abaixo) ───────────
# Tag da imagem upstream (ex.: 3.3.1 para fixar/rollback)
AI_MEMORY_IMAGE_TAG=latest

# Provedor de LLM para consolidação (vazio = modo zero-LLM): anthropic, openai, openai-compat
AI_MEMORY_LLM_PROVIDER=

# Modelo do LLM (vazio = default do provedor)
AI_MEMORY_LLM_MODEL=

# Base URL do LLM (openai-compat: OpenRouter, Ollama, vLLM, LiteLLM...)
AI_MEMORY_LLM_BASE_URL=

# Chave da API Anthropic (provedor anthropic)
ANTHROPIC_API_KEY=

# Chave da API OpenAI (provedor openai)
OPENAI_API_KEY=

# Chave genérica (provedor openai-compat)
LLM_API_KEY=

# Nível de log (RUST_LOG)
AI_MEMORY_RUST_LOG=ai_memory=info,ai_memory_store=info,ai_memory_wiki=info,ai_memory_mcp=info,tracing_appender=warn

# Rede do proxy
PROXY_NET=web
