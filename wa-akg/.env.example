# Variáveis para subir a stack "wa-akg".
# Copie para .env e preencha as OBRIGATÓRIAS:  cp .env.example .env
# (No Portainer App Template, esses valores são pedidos no formulário.)

# ─────────── Obrigatórias ───────────
# Dominio (FQDN) — Ex.: wa.exemplo.com [OBRIGATÓRIA]
WA_AKG_FQDN=

# Chave de sessao — Chave de criptografia de sessao do NextAuth (openssl rand -base64 32) [OBRIGATÓRIA]
WA_AKG_AUTH_SECRET=

# Senha root do banco — Senha root do MySQL embarcado (tambem usada pelo app) [OBRIGATÓRIA]
WA_AKG_DB_ROOT_PASSWORD=

# E-mail do admin — Criado no primeiro boot [OBRIGATÓRIA]
WA_AKG_ADMIN_EMAIL=

# Senha do admin — Criado no primeiro boot [OBRIGATÓRIA]
WA_AKG_ADMIN_PASSWORD=

# ─────────── Opcionais (defaults abaixo) ───────────
# Banco usado pela aplicacao
WA_AKG_DB_NAME=wa_akg

# Nivel de log do engine Baileys (fatal/error/warn/info/debug/trace)
WA_AKG_LOG_LEVEL=error

# Habilita a UI do Swagger em /docs
WA_AKG_SWAGGER_ENABLED=false

# Usuario do basic auth do Swagger
WA_AKG_SWAGGER_USERNAME=admin

# Senha do basic auth do Swagger (defina ao habilitar WA_AKG_SWAGGER_ENABLED)
WA_AKG_SWAGGER_PASSWORD=

# Timezone do servidor
WA_AKG_TZ=America/Sao_Paulo

# Locale de datas/horas na UI
WA_AKG_LOCALE=pt-BR

# Rede do proxy
PROXY_NET=web

# Rede de dados
DATA_NET=data
