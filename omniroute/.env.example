# Variáveis para subir a stack "omniroute". Copie para .env: cp .env.example .env
# (No Portainer App Template, esses valores são pedidos no formulário.)

# ─────────── Obrigatórias ───────────
# Dominio (FQDN) — Ex.: omniroute.exemplo.com [OBRIGATÓRIA]
OMNIROUTE_FQDN=

# Chave de assinatura das sessoes do dashboard (openssl rand -base64 48) [OBRIGATÓRIA]
OMNIROUTE_JWT_SECRET=

# Chave de criptografia das API keys dos provedores, guardadas no SQLite (openssl rand -hex 32) [OBRIGATÓRIA]
OMNIROUTE_API_KEY_SECRET=

# Senha inicial do admin do dashboard — troque no primeiro login [OBRIGATÓRIA]
OMNIROUTE_INITIAL_PASSWORD=

# ─────────── Opcionais (defaults abaixo) ───────────
# Chave de criptografia do banco SQLite inteiro em repouso (openssl rand -hex 32). Vazio = sem criptografia extra.
OMNIROUTE_STORAGE_ENCRYPTION_KEY=

# Exigir API key nos endpoints /v1/* (proxy OpenAI-compatible). Mantenha "true" com o FQDN publico.
OMNIROUTE_REQUIRE_API_KEY=true

# Tag da imagem (Docker Hub diegosouzapw/omniroute). Use "latest-web" para provedores web-cookie
# (gemini-web, claude-web, claude-turnstile) — inclui Playwright/Chromium.
OMNIROUTE_IMAGE_TAG=latest

# Tag da imagem Redis (cache/rate-limiter embarcado)
OMNIROUTE_REDIS_IMAGE_TAG=8-alpine

# URI do Redis (rate limiter distribuido)
OMNIROUTE_REDIS_URL=redis://redis:6379

# Rede externa do Traefik
PROXY_NET=web

# Rede externa p/ ferramentas de admin alcançarem o Redis desta stack
DATA_NET=data
