# Variaveis para subir a stack "sygnal". Copie para .env: cp .env.example .env

# Dominio publico do gateway de push (FQDN), onde qualquer homeserver Matrix vai
# bater com POST /_matrix/push/v1/notify. Ex.: push.exemplo.com [OBRIGATORIA]
SYGNAL_FQDN=

# Tag da imagem matrixdotorg/sygnal (Docker Hub).
SYGNAL_IMAGE_TAG=v0.17.0

# Rede externa do Traefik.
PROXY_NET=web

# --- Docker Swarm (type 2): nomes dos Docker configs externos — ver README ---
SYGNAL_CONFIG_NAME=sygnal_config_v1
SYGNAL_FCM_CREDENTIAL_NAME=sygnal_fcm_credential_v1

# --- Standalone (type 3): caminhos locais dos arquivos montados por bind mount ---
SYGNAL_CONFIG_FILE=./config/sygnal.yaml
SYGNAL_FCM_CREDENTIAL_FILE=./config/firebase-service-account.json

# Porta publicada no host quando o acesso direto sem Traefik (bloco "ports:" comentado
# no compose) estiver habilitado.
SYGNAL_EXTERNAL_PORT=8105
