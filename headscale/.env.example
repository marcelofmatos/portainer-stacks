# Variáveis para subir a stack "headscale". Copie para .env: cp .env.example .env
# (No Portainer App Template, esses valores são pedidos no formulário.)

# ─────────── Obrigatórias ───────────
# Domínio (FQDN) público do Headscale — Ex.: vpn.exemplo.com [OBRIGATÓRIA]
HEADSCALE_FQDN=

# ─────────── Opcionais (defaults abaixo) ───────────
# Domínio MagicDNS dos nós (<host>.<domínio>) — precisa ser DIFERENTE do HEADSCALE_FQDN
HEADSCALE_BASE_DOMAIN=vpn.internal

# Faixa IPv4 dos nós
HEADSCALE_PREFIX_V4=100.64.0.0/10

# Faixa IPv6 dos nós
HEADSCALE_PREFIX_V6=fd7a:115c:a1e0::/48

# DERP embutido (relay próprio + STUN 3478/udp) — true/false
HEADSCALE_DERP_SERVER_ENABLED=false

# IPv4 público do host (só com DERP embutido ligado)
HEADSCALE_DERP_SERVER_IPV4=

# Nível de log (debug, info, warn, error)
HEADSCALE_LOG_LEVEL=info

# Tag da imagem headscale/headscale (fixe a minor: há mudanças incompatíveis entre minors)
HEADSCALE_IMAGE_TAG=0.29

# Rede do proxy
PROXY_NET=web
