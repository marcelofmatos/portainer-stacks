# Variáveis para subir a stack "ldap-self-signup".
# Copie para .env e preencha as OBRIGATÓRIAS:  cp .env.example .env
# (No Portainer App Template, esses valores são pedidos no formulário.)

# ─────────── Obrigatórias ───────────
# Domínio público do cadastro — Ex.: acesso.exemplo.org [OBRIGATÓRIA]
SIGNUP_FQDN=

# DN de bind no LDAP (precisa criar contas e alterar grupos) — Ex.: cn=admin,dc=exemplo,dc=org [OBRIGATÓRIA]
LDAP_BIND_DN=

# Base das contas — Ex.: ou=Users,dc=exemplo,dc=org [OBRIGATÓRIA]
LDAP_USERS_BASE=

# Grupo padrão das contas novas — Ex.: cn=Usuario,ou=Groups,dc=exemplo,dc=org [OBRIGATÓRIA]
LDAP_DEFAULT_GROUP_DN=

# Servidor SMTP — Ex.: smtp-relay.brevo.com [OBRIGATÓRIA]
SMTP_HOST=

# Remetente dos e-mails — Ex.: acesso@exemplo.org [OBRIGATÓRIA]
SMTP_FROM=

# Caixa que recebe os avisos de nova solicitação [OBRIGATÓRIA]
ADMIN_NOTIFY_EMAIL=

# Só no Compose (standalone): senha do bind LDAP [OBRIGATÓRIA no standalone]
LDAP_BIND_PW=

# Só no Compose (standalone): chave da sessão — openssl rand -hex 32 [OBRIGATÓRIA no standalone]
SECRET_KEY=

# ─────────── Admins (preencha um dos dois) ───────────
# DN do grupo cujos membros (memberUid) entram no painel — Ex.: cn=Admins,ou=Groups,dc=exemplo,dc=org
ADMIN_GROUP_DN=

# Lista de uids admin, separados por vírgula
ADMIN_UIDS=

# ─────────── Opcionais ───────────
APP_IMAGE_TAG=latest
LDAP_URL=ldap://account_ldap:389
LDAP_DEFAULT_GID=10000
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
# Só no Compose (standalone): senha SMTP
SMTP_PASSWORD=
TRUSTED_PROXIES=1
TIMEZONE_EXIBICAO=America/Sao_Paulo
TOKEN_TTL_HOURS=24
CONVITE_TTL_DIAS=7
RATE_LIMIT_FORM=10/hora
RATE_LIMIT_LOGIN=10/15min
PROXY_NET=web
LDAP_NET=ldap

# Só no Swarm: nomes dos secrets e configs externos
SECRET_LDAP_BIND_PW=ldap_self_signup_ldap_bind_pw
SECRET_SECRET_KEY=ldap_self_signup_secret_key
SECRET_SMTP_PASSWORD=ldap_self_signup_smtp_password
PRIVACIDADE_CONFIG_NAME=ldap_self_signup_privacidade_v1
TEMA_CONFIG_NAME=ldap_self_signup_tema_v1

# Só no Compose (standalone): pasta do tema montada em /template
SIGNUP_TEMPLATE_DIR=./template
