# Variáveis para subir a stack "uptime-kuma". Copie para .env: cp .env.example .env
# (No Portainer App Template, esses valores são pedidos no formulário.)

# ─────────── Obrigatórias ───────────
# Domínio (FQDN) — Ex.: status.exemplo.com [OBRIGATÓRIA]
KUMA_FQDN=

# ─────────── Opcionais (defaults abaixo) ───────────
# Fuso horário (horário dos alertas e gráficos)
TZ=America/Sao_Paulo

# Tag da imagem louislam/uptime-kuma
KUMA_IMAGE_TAG=2

# Rede do proxy
PROXY_NET=web

# Rede de dados (monitorar serviços internos pelo nome)
DATA_NET=data
